# ============================================================
# 复制本文件为 .env 后填入真实内容（.env 已在 .gitignore 中，不会进仓库）
# 队友 A 的后端读 DEEPSEEK_API_KEY，成员 B 的 UI 读 LLM_API_KEY，
# bridge/config.py 会自动互认，填其中一个即可。
# ============================================================

# ---- 大模型（二选一即可）----
DEEPSEEK_API_KEY=sk-在这里填你的DeepSeek密钥
# LLM_API_KEY=sk-在这里填你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 存储（MCP 工具与看板共用同一个库，改这里两边同步生效）----
TODO_DB_PATH=data/todos.db
TODO_MEMORY_PATH=data/user_memory.json
TODO_EXPORT_PATH=data/todo_export.md

# ---- 离线演示：不开网、不烧 token，用规则大脑跑通全链路 ----
# USE_MOCK_LLM=1
